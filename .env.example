# Local development only. Never commit real credentials.
DATABASE_URL="postgresql://stordex:stordex@localhost:5432/stordex?schema=public"
DIRECT_URL="postgresql://stordex:stordex@localhost:5432/stordex?schema=public"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
APP_ENV="local"

# AWS runtime uses the SST secrets DatabaseUrl, NextAuthSecret and NextAuthUrl.
# For Supabase staging, copy .env.staging.example and use separate pooled/runtime
# and direct-or-session/migration connection strings.

