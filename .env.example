# --- 環境別 .env テンプレート ---
# 用途: ローカル(local) / ステージング(staging) / 本番(prod)
# このファイルはコミットされます。実値は各 .env / .env.staging / Vercel・SST シークレットに入れてください。

# === LOCAL（ローカル開発） ===
# brew install postgresql@16 で構築するか、Docker:
#   docker run -d --name stordex-pg -p 5432:5432 -e POSTGRES_PASSWORD=stordex -e POSTGRES_USER=stordex -e POSTGRES_DB=stordex postgres:16
DATABASE_URL="postgresql://stordex:stordex@localhost:5432/stordex?schema=public"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
# 環境識別（任意 / ヘッダ表示等に使用可）
APP_ENV="local"

# === STAGING（インターネット動作確認 / Neon + Vercel） ===
# 1. Neon でプロジェクト作成 → 接続文字列をコピー
# 2. Vercel の Project Settings → Environment Variables に登録（Production/Preview 両方）
# DATABASE_URL="postgresql://<user>:<pass>@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# NEXTAUTH_SECRET="<openssl rand -base64 32>"
# NEXTAUTH_URL="https://stordex-dev.vercel.app"
# APP_ENV="staging"

# === PROD（AWS Aurora Serverless v2） ===
# SST シークレットから自動注入されるため、ここで直接設定不要。
# npx sst secret set NextAuthSecret "$(openssl rand -base64 32)" --stage prod
# npx sst secret set NextAuthUrl    "https://app.example.com"   --stage prod
# DATABASE_URL は sst.config.ts が Aurora から interpolate
# APP_ENV="prod"
