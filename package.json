{
  "name": "stordex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:staging": "dotenv -e .env.staging -- prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:staging": "dotenv -e .env.staging -- tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:studio:staging": "dotenv -e .env.staging -- prisma studio",
    "issue-token": "tsx scripts/issue-signup-token.ts",
    "suspend-tenant": "tsx scripts/suspend-tenant.ts",
    "reactivate-tenant": "tsx scripts/reactivate-tenant.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.11.1",
    "next": "^16.3.4",
    "next-auth": "^4.24.15",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/ui": "^4.1.11",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8.5.26",
    "prisma": "^7.10.0",
    "sst": "4.17.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "deepmerge-ts": "^8.0.1"
  },
  "engines": {
    "node": "22.x"
  },
  "type": "module"
}
