{
  "name": "stordex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:staging": "dotenv -e .env.staging -- prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:staging": "dotenv -e .env.staging -- tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:studio:staging": "dotenv -e .env.staging -- prisma studio",
    "issue-token": "tsx scripts/issue-signup-token.ts",
    "suspend-tenant": "tsx scripts/suspend-tenant.ts",
    "reactivate-tenant": "tsx scripts/reactivate-tenant.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.7.2",
    "next": "^16.3.3",
    "next-auth": "^4.24.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8.5.26",
    "prisma": "^5.22.0",
    "sst": "4.17.1",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": "22.x"
  }
}
