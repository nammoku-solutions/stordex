// Stordex Prisma schema — multi-tenant SaaS for order & inventory management.
// All tenant-scoped tables include `tenantId` and a composite uniqueness with
// human-friendly codes so each tenant has its own namespace.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum MovementType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum TradingConnectionStatus {
  PENDING
  ACTIVE
  DECLINED
  REVOKED
}

enum IntercompanyOrderStatus {
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ImportTarget {
  CUSTOMER
  SUPPLIER
  ITEM
  ORDER
}

enum ImportJobStatus {
  PENDING
  DRYRUN_OK
  DRYRUN_FAILED
  COMMITTED
  FAILED
}


model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("standard")
  // 利用状態（請求未入金などで停止可能）
  status           TenantStatus @default(ACTIVE)
  suspendedAt      DateTime?
  suspendedReason  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  customers      Customer[]
  suppliers      Supplier[]
  items          Item[]
  orders         Order[]
  movements      InventoryMovement[]
  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  businessUnits  BusinessUnit[]
  warehouses     Warehouse[]
  importJobs     ImportJob[]
  tradingConnectionsA TradingConnection[] @relation("TradingTenantA")
  tradingConnectionsB TradingConnection[] @relation("TradingTenantB")
  outboundCompanyOrders IntercompanyOrder[] @relation("IntercompanyBuyer")
  inboundCompanyOrders  IntercompanyOrder[] @relation("IntercompanySeller")
}

// テナント新規作成用の招待トークン（Nammoku Solutions が入金確認後に発行）
model SignupInvitation {
  id              String    @id @default(cuid())
  token           String    @unique
  // 任意で事前にテナントslug/メールをロックできる（指定すれば signup 時にその値しか使えない）
  allowedTenantSlug String?
  allowedEmail      String?
  // 契約情報（管理用メモ）
  companyName     String?
  plan            String    @default("standard")
  note            String?
  // 失効
  expiresAt       DateTime?
  usedAt          DateTime?
  usedByTenantId  String?   // 使用後にどの Tenant が作られたか
  createdAt       DateTime  @default(now())
  createdBy       String?   // 発行者メモ（CLI 実行ユーザー名等）
}

// 倉庫（複数拠点対応）
model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  address   String?
  note      String?
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// 事業所（複数事業所対応 — レガシーアプリの請求書発行元情報）
model BusinessUnit {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  postalCode String?
  address    String?
  phone      String?
  fax        String?
  email      String?
  bankInfo   String? // 振込先情報
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([tenantId])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([email])
}

model Customer {
  id           String   @id @default(cuid())
  tenantId     String
  code         String
  name         String
  nameKana     String?
  nameEn       String? // 英語表記
  postalCode   String?
  address      String?
  phone        String?
  fax          String?
  email        String?
  contact      String?
  // 翌日注文（受注当日納品ではなく翌日納品が基本）
  nextDayOrder Boolean  @default(false)
  // 営業所
  branch       String?
  // 顧客グループ（請求書まとめ単位）
  groupName    String?
  note         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders     Order[]
  quotations Quotation[]
  invoices   Invoice[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
}

model Supplier {
  id         String   @id @default(cuid())
  tenantId   String
  code       String
  name       String
  nameKana   String?
  postalCode String?
  address    String?
  phone      String?
  fax        String?
  email      String?
  contact    String?
  note       String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items          Item[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
}

enum StockPolicy {
  STOCKED
  ON_DEMAND
}

enum PurchaseMode {
  UNIT
  PACK
}

model Item {
  id            String   @id @default(cuid())
  tenantId      String
  code          String
  name          String
  nameKana      String?
  nameEn        String? // 英語表記
  unit          String   @default("個")
  // 規格（サイズ・荷姿など）
  spec          String?
  // 産地
  origin        String?
  // 1ケース入数（在庫表のｹｰｽ入数）
  caseQty       Int?
  // 発注単位（1CS / 1KG / 10P 等）
  orderUnit     String?
  // 輸入品フラグ
  isImported    Boolean  @default(false)
  // 入荷曜日表示（例: "火" / "金" / "火・金"）
  deliveryCycle String?
  // バーコード/JAN
  barcode       String?
  // 在庫管理方針: 常備品/受注後仕入品（既存商品は従来どおり常備品）
  stockPolicy   StockPolicy @default(STOCKED)
  // 仕入単位。PACK の場合 caseQty 個で1パック/箱
  purchaseMode  PurchaseMode @default(UNIT)
  // 在庫数量
  stock         Int      @default(0)
  // 発注点（これを下回るとアラート）
  reorderPoint  Int      @default(0)
  // ピーク発注点（繁忙期の最低在庫）
  reorderPeak   Int?
  // 仕入単価
  costPrice     Int      @default(0)
  // 販売単価
  salesPrice    Int      @default(0)
  supplierId    String?
  category      String?
  note          String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier           Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  orderItems         OrderItem[]
  movements          InventoryMovement[]
  quotationItems     QuotationItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@index([tenantId, stockPolicy, active])
}

model Order {
  id          String      @id @default(cuid())
  tenantId    String
  orderNumber String
  customerId  String
  orderDate   DateTime    @default(now())
  dueDate     DateTime?
  status      OrderStatus @default(DRAFT)
  subtotal    Int         @default(0)
  taxRate     Int         @default(10)
  tax         Int         @default(0)
  total       Int         @default(0)
  // 発注者（電話受注時の担当者名）
  orderer     String?
  note        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  invoiceLinks InvoiceOrder[]
  linkedCompanyOrder IntercompanyOrder? @relation("IntercompanySellerOrder")

  @@unique([tenantId, orderNumber])
  @@index([tenantId, orderDate])
  @@index([tenantId, dueDate])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  itemId    String
  itemName  String
  unit      String
  // 規格・産地（受注時点のスナップショット）
  spec      String?
  origin    String?
  quantity  Int
  unitPrice Int
  costPrice Int     @default(0)
  amount    Int
  // 摘要（レガシーの適用1〜5に相当）
  remark    String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  Item  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model InventoryMovement {
  id          String       @id @default(cuid())
  tenantId    String
  itemId      String
  type        MovementType
  quantity    Int
  // 移動後の残在庫
  balance     Int
  // ロット番号（賞味期限管理）
  lotNumber   String?
  // 賞味期限
  expiryDate  DateTime?
  // 保管場所/棚番（例: "冷蔵A-3"）
  location    String?
  warehouseId String?
  reference   String? // 注文番号など
  note        String?
  createdAt   DateTime     @default(now())
  createdBy   String?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item      Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([itemId])
}

// 見積書
model Quotation {
  id              String          @id @default(cuid())
  tenantId        String
  quotationNumber String
  customerId      String
  issueDate       DateTime        @default(now())
  validUntil      DateTime?
  status          QuotationStatus @default(DRAFT)
  subtotal        Int             @default(0)
  taxRate         Int             @default(10)
  tax             Int             @default(0)
  total           Int             @default(0)
  // 担当者（レガシーのForm6で入力）
  contactName     String?
  contactPhone    String?
  note            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    QuotationItem[]

  @@unique([tenantId, quotationNumber])
  @@index([tenantId, issueDate])
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  itemId      String?
  itemName    String
  spec        String?
  unit        String
  quantity    Int
  unitPrice   Int
  amount      Int

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  item      Item?     @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([quotationId])
}

// 仕入先発注（市場発注）
model PurchaseOrder {
  id         String              @id @default(cuid())
  tenantId   String
  poNumber   String
  supplierId String
  orderDate  DateTime            @default(now())
  // 引取日
  pickupDate DateTime?
  status     PurchaseOrderStatus @default(DRAFT)
  subtotal   Int                 @default(0)
  taxRate    Int                 @default(10)
  tax        Int                 @default(0)
  total      Int                 @default(0)
  note       String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items    PurchaseOrderItem[]
  linkedCompanyOrder IntercompanyOrder? @relation("IntercompanySourcePO")

  @@unique([tenantId, poNumber])
  @@index([tenantId, orderDate])
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  itemId          String
  itemName        String
  unit            String
  quantity        Int
  unitPrice       Int
  amount          Int
  // 入荷済数量（部分入荷対応）
  received        Int    @default(0)
  // Immutable order-time supplier pack snapshot; quantity remains BASE units.
  packSize        Int?
  packUnit        String?
  packCount       Int?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
}

// 請求書（月次請求 — 複数受注を集約）
model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  invoiceNumber  String
  customerId     String
  // 請求元事業所（複数事業所対応）
  businessUnitId String?
  // 締め年月（例: 2025年4月分）
  periodYear     Int
  periodMonth    Int
  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  status         InvoiceStatus @default(DRAFT)
  subtotal       Int           @default(0)
  taxRate        Int           @default(10)
  tax            Int           @default(0)
  total          Int           @default(0)
  // レガシーのcheckBox1: 伝票ごとに消費税
  taxPerOrder    Boolean       @default(false)
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  businessUnit BusinessUnit?  @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  orders       InvoiceOrder[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, periodYear, periodMonth])
}

// 請求書 ↔ 受注 の中間テーブル（1請求書に複数受注）
model InvoiceOrder {
  invoiceId String
  orderId   String

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@id([invoiceId, orderId])
  @@index([orderId])
}

// An approved trading relationship is required before any cross-tenant order exchange.
// Always persist tenantAId < tenantBId to prevent reverse-direction duplicates.
model TradingConnection {
  id                  String                  @id @default(cuid())
  tenantAId           String
  tenantBId           String
  requestedByTenantId String
  status              TradingConnectionStatus @default(PENDING)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  tenantA Tenant @relation("TradingTenantA", fields: [tenantAId], references: [id], onDelete: Cascade)
  tenantB Tenant @relation("TradingTenantB", fields: [tenantBId], references: [id], onDelete: Cascade)
  companyOrders IntercompanyOrder[]

  @@unique([tenantAId, tenantBId])
  @@index([tenantBId, status])
  @@index([tenantAId, status])
}

// Immutable buyer order snapshot, routed only across an ACTIVE bilateral relationship.
// The seller must explicitly map SKUs/customers before its own draft Order is created.
model IntercompanyOrder {
  id               String                   @id @default(cuid())
  connectionId     String
  buyerTenantId    String
  sellerTenantId   String
  purchaseOrderId  String                   @unique
  sellerOrderId    String?                  @unique
  poNumber         String
  orderDate        DateTime
  deliveryDate     DateTime?
  subtotal         Int
  taxRate          Int
  tax              Int
  total            Int
  note             String?
  status           IntercompanyOrderStatus  @default(SENT)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  connection    TradingConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  buyer         Tenant            @relation("IntercompanyBuyer", fields: [buyerTenantId], references: [id], onDelete: Restrict)
  seller        Tenant            @relation("IntercompanySeller", fields: [sellerTenantId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder     @relation("IntercompanySourcePO", fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  sellerOrder   Order?            @relation("IntercompanySellerOrder", fields: [sellerOrderId], references: [id], onDelete: Restrict)
  items         IntercompanyOrderItem[]

  @@index([sellerTenantId, status, createdAt])
  @@index([buyerTenantId, createdAt])
}

model IntercompanyOrderItem {
  id                         String @id @default(cuid())
  intercompanyOrderId        String
  sourcePurchaseOrderItemId  String
  buyerItemCode              String
  itemName                   String
  unit                       String
  quantity                   Int
  unitPrice                  Int
  amount                     Int

  order IntercompanyOrder @relation(fields: [intercompanyOrderId], references: [id], onDelete: Cascade)

  @@unique([intercompanyOrderId, sourcePurchaseOrderItemId], map: "IntercompanyOrderItem_intercompanyOrderId_sourcePurchaseOrderIt")
  @@index([intercompanyOrderId])
}

// Tenant-local audit trail for CSV preview, dry run and commit results.
model ImportJob {
  id           String          @id @default(cuid())
  tenantId     String
  userId       String?
  target       ImportTarget
  fileName     String
  rowCount     Int             @default(0)
  createdCount Int             @default(0)
  updatedCount Int             @default(0)
  skippedCount Int             @default(0)
  errorCount   Int             @default(0)
  status       ImportJobStatus @default(PENDING)
  errorCsv     String?
  summary      String?
  createdAt    DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}
